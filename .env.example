# Core app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snap_interview
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/snap_interview
# Optional per-instance PostgreSQL pool cap. Defaults to 2 in development and production.
# DATABASE_POOL_MAX=2
AUTH_SECRET=replace-with-a-long-random-secret

# Local dev (use these values locally)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Production (Vercel — all three must match your public origin)
# BETTER_AUTH_URL=https://snapinterview.app
# NEXT_PUBLIC_APP_URL=https://snapinterview.app
# APP_URL=https://snapinterview.app

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider
GROQ_API_KEY=

# Optional emergency TTS fallback (unused by the Kokoro interview client)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FRIENDLY=
# ELEVENLABS_VOICE_BALANCED=
# ELEVENLABS_VOICE_STRICT=

# Text-to-speech (browser-local Kokoro)
# Set to false only to disable spoken interview audio.
NEXT_PUBLIC_LOCAL_TTS_ENABLED=true

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Email (optional in local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CSRF origin controls (optional)
# Comma-separated full origins, e.g. "http://localhost:3000,https://snapinterview.app"
CSRF_TRUSTED_ORIGINS=
# Comma-separated owned-domain suffixes, e.g. ".mycompany.com" (do not use shared hosts like .vercel.app)
CSRF_TRUSTED_ORIGIN_SUFFIXES=

# Cron job secret (required in production; configure a strong value in the host)
CRON_SECRET=
