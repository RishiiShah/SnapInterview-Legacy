# Core app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snap_interview
AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider
GROQ_API_KEY=

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Email (optional in local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CSRF origin controls (optional)
# Comma-separated full origins, e.g. "http://localhost:3000,https://snapinterview.app"
CSRF_TRUSTED_ORIGINS=
# Comma-separated suffixes, e.g. ".vercel.app,.mycompany.com"
CSRF_TRUSTED_ORIGIN_SUFFIXES=
