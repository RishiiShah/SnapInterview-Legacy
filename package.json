    "@types/nodemailer": "^7.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "hono": "^4.12.7",
    "@hono/node-server": "^1.19.11",
    "effect": "^3.20.0"
  }
