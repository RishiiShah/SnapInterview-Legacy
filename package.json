    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.5",
    "disposable-email-domains": "^1.0.62",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "nodemailer": "^7.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
