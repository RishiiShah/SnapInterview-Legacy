    "postcss": "^8.5.13",
    "sharp": "^0.35.3",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "dompurify": "^3.4.12",
    "fast-uri": "^3.1.5"
  },
  "engines": {
    "node": "24.x"
  }
