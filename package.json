{
  "name": "snap-interview",
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backfill:video-keys": "tsx src/lib/maintenance/backfill-video-keys.ts",
    "cleanup:evaluations:preview": "npx prisma db execute --file src/lib/maintenance/sql/preview-invalid-evaluations.sql",
    "cleanup:evaluations": "npx prisma db execute --file src/lib/maintenance/sql/cleanup-invalid-evaluations.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^2.0.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "disposable-email-domains": "1.0.62",
    "framer-motion": "12.43.0",
    "groq-sdk": "^1.5.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
