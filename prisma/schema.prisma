generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Core Models ──────────────────────────────────────────────────
// These models are required by Better Auth. Field names and types must match
// what Better Auth expects from its Prisma adapter.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── App-specific user fields ───
  isFirstLogin           Boolean   @default(true)
  failedLoginCount       Int       @default(0)
  lockedUntil            DateTime?
  lastPasswordChangedAt  DateTime?
  onboardingCompletedAt  DateTime?
  onboardingRole         String?
  onboardingLevel        String?
  onboardingCompany      String?
  onboardingGoal         String?
  preferredInterviewType    String?
  notificationPrefs         Json      @default("{\"emailNotifs\":true,\"practiceReminders\":true,\"weeklyReport\":true,\"scoreAlerts\":false}")
  notificationsLastReadAt   DateTime?
  resumeText                String?   @db.Text

  // ─── Relations ───
  sessions             Session[]
  accounts             Account[]
  interviewSessions    InterviewSession[]
  solvedQuestions      SolvedQuestion[]
  passwordResetCodes   PasswordResetCode[]
  securityEvents       SecurityEvent[]
  pendingRegistrations PendingUser[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
}

// ─── App: Pending Registrations (OTP-based signup) ────────────────────────────

model PendingUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  otpHash       String
  attemptCount  Int       @default(0)
  lockedUntil   DateTime?
  lastOtpSentAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── App: Security & Auth Events ─────────────────────────────────────────────

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  REGISTRATION_OTP_FAILED
  REGISTRATION_OTP_VERIFIED
  ACCOUNT_DELETED
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  userId       String
  email        String
  codeHash     String
  attemptCount Int       @default(0)
  lockedUntil  DateTime?
  expiresAt    DateTime
  usedAt       DateTime?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?
  email     String?
  type      SecurityEventType
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  namespace   String
  keyHash     String
  windowStart DateTime
  windowMs    Int
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, keyHash, windowStart])
  @@index([namespace, keyHash])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ─── App: Interviews ─────────────────────────────────────────────────────────

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model InterviewSession {
  id              String          @id @default(uuid())
  userId          String
  role            String
  company         String?
  type            String
  difficulty      String
  persona         String?
  jobDescription  String?         @db.Text
  resumeUrl       String?
  resumeText      String?  @db.Text
  videoUrl        String?
  videoKey        String?         @unique
  status          InterviewStatus @default(IN_PROGRESS)
  questionCount   Int             @default(10)
  currentQuestion Int             @default(0)
  focusAreas      Json?
  sessionPlan     Json?
  evaluation      Json?
  shareToken      String?         @unique
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript       TranscriptEntry[]
  questionFeedback QuestionFeedback[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model QuestionFeedback {
  id                 String           @id @default(cuid())
  interviewSessionId String
  questionOrder      Int
  rating             String
  createdAt          DateTime         @default(now())
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@unique([interviewSessionId, questionOrder])
  @@index([interviewSessionId])
}

model TranscriptEntry {
  id                 String           @id @default(uuid())
  interviewSessionId String
  order              Int
  question           String           @db.Text
  answer             String           @db.Text
  createdAt          DateTime         @default(now())
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([interviewSessionId])
  @@unique([interviewSessionId, order])
}

// ─── App: Practice Questions ─────────────────────────────────────────────────

model PracticeQuestion {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  text          String   @db.Text
  category      String
  difficulty    String
  estimatedTime String?
  tags          String[]
  hint          String?  @db.Text
  sampleAnswer  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  solvedBy      SolvedQuestion[]
}

model SolvedQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId Int
  solvedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}
