generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js / NextAuth Models ───

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  isFirstLogin      Boolean            @default(true)
  accounts          Account[]
  sessions          Session[]
  interviewSessions InterviewSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingUser {
  id           String   @id @default(cuid())
  name         String
  email        String
  passwordHash String
  otp          String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

// ─── Interview Sessions ───

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model InterviewSession {
  id              String          @id @default(uuid())
  userId          String
  role            String
  company         String?
  type            String
  difficulty      String
  jobDescription  String?         @db.Text
  resumeUrl       String?
  videoUrl        String?
  status          InterviewStatus @default(IN_PROGRESS)
  questionCount   Int             @default(10)
  currentQuestion Int             @default(0)
  createdAt       DateTime        @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript TranscriptEntry[]

  @@index([userId])
}

// ─── Interview Transcript (Q&A pairs) ───

model TranscriptEntry {
  id                 String @id @default(uuid())
  interviewSessionId String
  order              Int // 0-based sequence number
  question           String @db.Text
  answer             String @db.Text

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  @@index([interviewSessionId])
}
