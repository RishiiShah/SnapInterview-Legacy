generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Core Models ──────────────────────────────────────────────────
// These models are required by Better Auth. Field names and types must match
// what Better Auth expects from its Prisma adapter.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── App-specific user fields ───
  isAdmin                 Boolean   @default(false)
  isFirstLogin            Boolean   @default(true)
  failedLoginCount        Int       @default(0)
  lockedUntil             DateTime?
  lastPasswordChangedAt   DateTime?
  onboardingCompletedAt   DateTime?
  onboardingRole          String?
  onboardingLevel         String?
  onboardingCompany       String?
  onboardingGoal          String?
  preferredInterviewType  String?
  notificationPrefs       Json      @default("{\"emailNotifs\":true,\"practiceReminders\":true,\"weeklyReport\":true,\"scoreAlerts\":false}")
  notificationsLastReadAt DateTime?
  resumeText              String?   @db.Text

  // ─── Relations ───
  sessions             Session[]
  accounts             Account[]
  interviewSessions    InterviewSession[]
  solvedQuestions      SolvedQuestion[]
  passwordResetCodes   PasswordResetCode[]
  securityEvents       SecurityEvent[]
  pendingRegistrations PendingUser[]
  supportTickets       SupportTicket[]
  interviewPlans       InterviewPlan[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
}

// ─── App: Pending Registrations (OTP-based signup) ────────────────────────────

model PendingUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  otpHash       String
  attemptCount  Int       @default(0)
  lockedUntil   DateTime?
  lastOtpSentAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── App: Security & Auth Events ─────────────────────────────────────────────

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  REGISTRATION_OTP_FAILED
  REGISTRATION_OTP_VERIFIED
  ACCOUNT_DELETED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  userId       String
  email        String
  codeHash     String
  attemptCount Int       @default(0)
  lockedUntil  DateTime?
  expiresAt    DateTime
  usedAt       DateTime?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?
  email     String?
  type      SecurityEventType
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  namespace   String
  keyHash     String
  windowStart DateTime
  windowMs    Int
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, keyHash, windowStart])
  @@index([namespace, keyHash])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ─── App: Interviews ─────────────────────────────────────────────────────────

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model InterviewSession {
  id                     String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                 String
  role                   String
  company                String?
  type                   String
  difficulty             String
  level                  String?
  persona                String?
  jobDescription         String?                   @db.Text
  resumeUrl              String?
  resumeText             String?                   @db.Text
  durationMinutes        Int                       @default(30)
  videoUrl               String?
  videoKey               String?                   @unique
  status                 InterviewStatus           @default(IN_PROGRESS)
  questionCount          Int                       @default(10)
  currentQuestion        Int                       @default(0)
  focusAreas             Json?
  sessionPlan            Json?
  evaluation             Json?
  evaluationStartedAt    DateTime?
  evaluationClaimVersion Int                       @default(0)
  shareToken             String?                   @unique
  deletedAt              DateTime?
  createdAt              DateTime                  @default(now())
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript             TranscriptEntry[]
  questionFeedback       QuestionFeedback[]
  moderationNotes        InterviewModerationNote[]
  retrievedQuestions     RetrievedQuestion[]
  planNodes              InterviewPlanNode[]
  voiceAnalysis          VoiceAnalysis?
  replayTurns            InterviewReplayTurn[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@index([userId, status, deletedAt, createdAt(sort: Desc)])
  @@index([status, createdAt], map: "InterviewSession_resume_expiry_idx")
  @@index([userId, status, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "InterviewSession_recordings_cursor_idx")
  @@index([userId, role, deletedAt, id], map: "InterviewSession_rag_retrieval_scope_idx")
}

model InterviewReplayTurn {
  id                 String           @id @default(cuid())
  interviewSessionId String
  transcriptOrder    Int
  questionStartMs    Int?
  questionEndMs      Int?
  answerStartMs      Int?
  answerEndMs        Int?
  timingSource       String           @default("browser-v1")
  confidenceScore    Float            @default(0.8)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@unique([interviewSessionId, transcriptOrder])
  @@index([interviewSessionId])
}

model VoiceAnalysis {
  id                 String              @id @default(cuid())
  interviewSessionId String              @unique
  status             String              @default("COLLECTING")
  analyzerVersion    String              @default("browser-v1")
  audioQualityScore  Float?
  confidenceScore    Float?
  aggregateMetrics   Json?
  coachingSummary    String?             @db.Text
  createdAt          DateTime            @default(now())
  completedAt        DateTime?
  interviewSession   InterviewSession    @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  turns              VoiceTurnAnalysis[]

  @@index([status, createdAt])
}

model VoiceTurnAnalysis {
  id                 String        @id @default(cuid())
  voiceAnalysisId    String
  transcriptOrder    Int
  responseLatencyMs  Int?
  speakingDurationMs Int?
  wordsPerMinute     Float?
  pauseRatio         Float?
  energyVariation    Float?
  fillerWordCount    Int           @default(0)
  audioQualityScore  Float?
  confidenceScore    Float
  createdAt          DateTime      @default(now())
  voiceAnalysis      VoiceAnalysis @relation(fields: [voiceAnalysisId], references: [id], onDelete: Cascade)

  @@unique([voiceAnalysisId, transcriptOrder])
  @@index([voiceAnalysisId])
}

model InterviewModerationNote {
  id                 String           @id @default(cuid())
  interviewSessionId String
  authorEmail        String
  note               String           @db.Text
  createdAt          DateTime         @default(now())
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([interviewSessionId, createdAt])
}

model QuestionFeedback {
  id                 String           @id @default(cuid())
  interviewSessionId String
  questionOrder      Int
  rating             String
  createdAt          DateTime         @default(now())
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@unique([interviewSessionId, questionOrder])
  @@index([interviewSessionId])
}

model TranscriptEntry {
  id                 String           @id @default(cuid())
  interviewSessionId String
  order              Int
  question           String           @db.Text
  answer             String           @db.Text
  createdAt          DateTime         @default(now())
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@unique([interviewSessionId, order])
  @@index([interviewSessionId])
}

// ─── App: Practice Questions ─────────────────────────────────────────────────

model PracticeQuestion {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  text          String           @db.Text
  category      String
  difficulty    String
  estimatedTime String?
  tags          String[]
  hint          String?          @db.Text
  sampleAnswer  String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  solvedBy      SolvedQuestion[]

  @@index([category])
}

model SolvedQuestion {
  id         String           @id @default(cuid())
  userId     String
  questionId Int
  solvedAt   DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  // Serves the solved-question API's per-user newest-first history query.
  @@index([userId, solvedAt(sort: Desc)], map: "SolvedQuestion_user_solvedAt_desc_idx")
}

// Candidate-authored DAGs that sequence mock interviews and practice sets.
model InterviewPlan {
  id                      String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerUserId             String
  title                   String
  status                  String              @default("draft")
  source                  String              @default("custom")
  templateKey             String?
  targetCompany           String?
  targetCompanyKey        String?
  targetRole              String?
  targetRoleSlug          String?
  targetRoleFamily        String?
  targetLevel             String?
  interviewDate           DateTime?
  jobDescription          String?             @db.Text
  blueprintKey            String?
  blueprintVersion        Int?
  blueprintReviewedAt     DateTime?
  blueprintResolution     String?
  customizedFromBlueprint Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  owner                   User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  nodes                   InterviewPlanNode[]
  edges                   InterviewPlanEdge[]

  @@index([ownerUserId, updatedAt(sort: Desc), id])
  @@index([ownerUserId, targetCompanyKey, targetRoleSlug, updatedAt(sort: Desc)])
}

model InterviewPlanNode {
  id                String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  planId            String
  nodeType          String
  title             String
  positionX         Float               @default(0)
  positionY         Float               @default(0)
  status            String
  config            Json
  resultInterviewId String?
  resultScore       Int?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  plan              InterviewPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  resultInterview   InterviewSession?   @relation(fields: [resultInterviewId], references: [id], onDelete: SetNull)
  outgoingEdges     InterviewPlanEdge[] @relation("PlanEdgeSource")
  incomingEdges     InterviewPlanEdge[] @relation("PlanEdgeTarget")

  @@index([planId])
  @@index([resultInterviewId])
}

model InterviewPlanEdge {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  planId       String
  sourceNodeId String
  targetNodeId String
  plan         InterviewPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sourceNode   InterviewPlanNode @relation("PlanEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   InterviewPlanNode @relation("PlanEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([planId, sourceNodeId, targetNodeId])
  @@index([planId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model CodingQuestion {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  description   String
  constraints   String?
  difficulty    String
  topics        String[]
  estimatedTime String?
  hint          String?
  starterCode   Json
  solutionCode  Json?
  isPublished   Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  testCases     CodingTestCase[]

  @@index([isPublished, sortOrder, createdAt])
}

model CodingTestCase {
  id             String         @id @default(cuid())
  questionId     String
  ordinal        Int
  input          String
  expectedOutput String
  isHidden       Boolean        @default(false)
  question       CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, ordinal])
}

// ─── App: Support Tickets ────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id             String       @id @default(cuid())
  ticketNumber   Int          @unique @default(autoincrement())
  userId         String
  userEmail      String
  userName       String
  category       String
  priority       String       @default("normal")
  subject        String
  description    String       @db.Text
  attachmentName String?
  attachmentUrl  String?
  status         TicketStatus @default(OPEN)
  resolvedAt     DateTime?
  adminNotes     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([ticketNumber])
  @@index([status, createdAt(sort: Desc)])
}

// ─── RAG: Interview Question Corpus ──────────────────────────────────────────
// Retrieval corpus backing interview question generation. `embedding` is a
// pgvector column Prisma cannot type, so it is written and queried with raw SQL
// (see src/lib/rag/). Everything else is ordinary Prisma.

model QuestionCorpus {
  id             String                      @id @default(cuid())
  // Original CSV question number. Kept stable so corpus counts and reviews can
  // refer back to the exact source row.
  sourceId       String?
  question       String                      @db.Text
  // Model answer, used to help grade the candidate. Present for the technical
  // questions; the behavioural set shipped without usable ones.
  answer         String?                     @db.Text
  commonMistakes String?                     @db.Text
  category       String
  // A hint, not a filter. The behavioural source labelled difficulty at random,
  // so use it to order results, never to exclude them.
  difficulty     String?
  level          String?
  // Interview types this question suits.
  types          String[]
  // Roles this question suits. Empty means it suits any role, which is true of
  // every behavioural question. Empty is deliberate, not missing data.
  roleTags       String[]
  keywords       String[]
  source         String
  // Fingerprint of the question text, used to avoid storing it twice. Only
  // exact repeats are removed. Questions that merely look similar are kept:
  // "What is OAuth..." and "What is Docker..." share a phrasing but ask
  // different things.
  contentHash    String                      @unique
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  retrievals RetrievedQuestion[]

  @@index([source])
  @@index([category])
  @@index([types], type: Gin)
  @@index([roleTags], type: Gin)
}

// Records which stored questions were used in which interview, so later turns
// and later interviews can skip them.
//
// An earlier version tried to work this out by comparing the questions the model
// actually asked against the stored ones. It never matched: the model rewrites a
// stored question into something much longer and more specific. Recording what
// was used replaces a guess with a fact.
model RetrievedQuestion {
  id                 String   @id @default(cuid())
  interviewSessionId String
  questionCorpusId   String
  // Which turn it was used on.
  questionOrder      Int
  createdAt          DateTime @default(now())

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  question         QuestionCorpus   @relation(fields: [questionCorpusId], references: [id], onDelete: Cascade)

  // Recorded once per interview, however many turns it appears on.
  @@unique([interviewSessionId, questionCorpusId])
  @@index([interviewSessionId])
  @@index([questionCorpusId])
}
